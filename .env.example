# Open Model API Configuration (Groq or OpenAI-compatible endpoint)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model Selection (Open weights models)
# e.g., llama-3.3-70b-versatile, llama-3.2-11b-vision-preview, qwen-2.5-32b
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
VISION_LLM_MODEL=llama-3.2-11b-vision-preview

# App Settings
APP_ENV=development
DATA_DIR=data
